# Copy to .env.local for local development. Both values are public by design (row-level security protects the data).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Never put the Supabase secret / service-role key in this app or in the repository.
# Admin alerts (web push, planning/02 D13). Make a pair once with: npx web-push generate-vapid-keys
# The public key is shared with browsers. The private key is a secret: set it only in Vercel's environment variables.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
