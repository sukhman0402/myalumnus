# Copy to .env.local for local development. Both values are public by design (row-level security protects the data).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Never put the Supabase secret / service-role key in this app or in the repository.
# Admin alerts (web push, planning/02 D13). Make a pair once with: npx web-push generate-vapid-keys
# The public key is shared with browsers. The private key is a secret: set it only in Vercel's environment variables.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Public case-study demo (optional). With NEXT_PUBLIC_DEMO_MODE=1 the sign-in page offers two profiles, Guard and
# Admin, that sign in to the demo accounts guard.demo@example.com and admin.demo@example.com (migration 0015).
# Their passwords are server-only; set them as sensitive variables in Vercel, never in the repo.
NEXT_PUBLIC_DEMO_MODE=
DEMO_GUARD_PASSWORD=
DEMO_ADMIN_PASSWORD=
